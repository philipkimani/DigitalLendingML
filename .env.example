# Copy to .env and fill in locally. Never commit .env.
# Authentication is Entra ID (az login locally, managed identity in Azure): there are no passwords here.

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-digitallending-dev
AZUREML_WORKSPACE=mlw-digitallending-dev
AZURE_CLIENT_ID=            # managed identity client id (set in Azure; leave empty locally)

# Postgres (Entra auth: PGUSER is your Entra UPN locally, the identity name in Azure)
PGHOST=
PGDATABASE=lending
PGUSER=
PGSSLMODE=require

# Optional: folder with the reference book and results for tests/parity
LENDING_REFERENCE_DIR=
