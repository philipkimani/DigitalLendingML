{
  "swagger": "2.0",
  "info": {
    "title": "Lending customer",
    "version": "1.0",
    "description": "Customer agent's only tool: one customer's account, in their own terms."
  },
  "host": "API_HOST",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "oauth2-auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
      "tokenUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
      "scopes": {}
    }
  },
  "security": [{ "oauth2-auth": [] }],
  "paths": {
    "/customers/{customer_id}/account": {
      "get": {
        "operationId": "GetAccount",
        "summary": "Get the customer's account",
        "description": "Use for questions about the customer's next payment, due date, when they can next be reviewed for an increase, their on-time record, or whether an increase is available.",
        "parameters": [
          { "name": "customer_id", "in": "path", "required": true, "type": "integer", "x-ms-summary": "Customer id", "description": "The id the customer gave at the start of this conversation." }
        ],
        "responses": {
          "200": {
            "description": "The account",
            "schema": {
              "type": "object",
              "properties": {
                "next_payment": {
                  "type": "object",
                  "x-ms-summary": "Next payment",
                  "properties": {
                    "amount": { "type": "number", "format": "float", "x-ms-summary": "Amount" },
                    "due_at": { "type": "string", "format": "date-time", "x-ms-summary": "Due" },
                    "status": { "type": "string", "x-ms-summary": "Status" }
                  }
                },
                "eligible_from": { "type": "string", "format": "date-time", "x-ms-summary": "Next review date" },
                "ontime_pct": { "type": "number", "format": "float", "x-ms-summary": "On-time percentage" },
                "ontime_target": { "type": "integer", "format": "int32", "x-ms-summary": "Next on-time target" },
                "decision": { "type": "string", "x-ms-summary": "Decision" },
                "message": { "type": "string", "x-ms-summary": "Message for the customer" },
                "new_limit": { "type": "number", "format": "float", "x-ms-summary": "New limit" }
              }
            }
          },
          "404": { "description": "No such customer" }
        }
      }
    }
  }
}
