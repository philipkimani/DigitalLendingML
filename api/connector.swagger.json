            },
            "fixed_cost": {
              "type": "number",
              "format": "float"
            },
            "fatigue": {
              "type": "number",
              "format": "float"
            },
            "horizon": {
              "type": "integer",
              "format": "int32"
            },
            "cycle": {
              "type": "integer",
              "format": "int32"
            },
            "max_k": {
