              "format": "float"
            },
            "fee": {
              "type": "number",
              "format": "float"
            },
            "c0": {
              "type": "number",
              "format": "float"
            },
            "c_deny": {
              "type": "number",
              "format": "float"
            },
            "k_prime": {
              "type": "number",
